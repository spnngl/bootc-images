<?xml version="1.0" encoding="utf-8"?>
<policy target="CONTINUE" priority="-10000">
  <short>Geo-blocking</short>
  <description>Drop incoming traffic from the public zone unless the source is in France. Runs before the blocklist policy (priority -9000). See PLAN.geoblock.md.</description>
  <ingress-zone name="public"/>
  <egress-zone name="HOST"/>
  <rule family="ipv4"><source ipset="geoblock-bogons-v4"/><drop/></rule>
  <rule family="ipv6"><source ipset="geoblock-bogons-v6"/><drop/></rule>
  <rule family="ipv4"><source ipset="geoblock-v4" invert="True"/><drop/></rule>
  <rule family="ipv6"><source ipset="geoblock-v6" invert="True"/><drop/></rule>
</policy>
