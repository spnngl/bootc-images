# syntax=docker.io/docker/dockerfile:1

# Minimal derived AlmaLinux bootc image.
#
# Build command:
#   podman build -f images/almalinux/Containerfile -t localhost/almalinux-bootc:latest images/almalinux
#
# scripts/build.sh does this and also builds a qcow2 disk image; scripts/run.sh
# boots it in QEMU.
#
# NB: This image ships no users, passwords or SSH keys.
# Docs: https://bootc.dev/bootc/building/guidance.html

# Available tags: https://quay.io/repository/almalinuxorg/almalinux-bootc?tab=tags
FROM quay.io/almalinuxorg/almalinux-bootc:10.2

USER root
SHELL ["/bin/bash", "-xeuo", "pipefail", "-c"]

RUN <<EORUN
# Install base stuff + repos
dnf -y install ca-certificates dnf-plugins-core glibc-langpack-en glibc-langpack-fr epel-release \
    sysstat iproute iputils procps-ng util-linux coreutils e2fsprogs mdadm lvm2 cryptsetup
dnf-3 config-manager --add-repo https://download.docker.com/linux/centos/docker-ce.repo

# Install packages
dnf -y install tree htop btrfs-progs firewalld netcat vim git nftables podman buildah systemd-networkd systemd-resolved \
    docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin docker-model-plugin
dnf -y autoremove
dnf clean all

# TZ
ln -sf ../usr/share/zoneinfo/Europe/Paris /etc/localtime

# chrony.conf has no include directory: replace its default pool with a
# sources directory, filled by etc/chrony/sources.d/. Fail if the pool line
# was not found.
sed -i 's|^pool .*|sourcedir /etc/chrony/sources.d|' /etc/chrony.conf
grep -qx 'sourcedir /etc/chrony/sources.d' /etc/chrony.conf

# Used ports
# - 80+443: HTTP(S)
# - 42022: sshd (etc/ssh/sshd_config.d/10-myssh.conf)
#
# TODO selinux one day
firewall-offline-cmd --add-port=80/tcp --add-port=443/tcp --add-port=42022/tcp

# Systemd services
systemctl disable NetworkManager
systemctl mask NetworkManager
systemctl enable sshd.service firewalld.service \
    systemd-resolved.service systemd-networkd.service \
    docker.service containerd.service mdmonitor.service

# Cleanup
rm -rf /var/log/* /var/cache/* /var/lib/dnf /tmp/* /run/dnf*
EORUN

# Copy static configuration files, keeping the modes of the build context
# (0755 directories, 0644 files). No --chmod: buildah applies it to
# directories too, and 0644 on /usr, /etc... breaks every non-root service
# (systemd-resolved included).
COPY --link ./fedora/sysroot/ /

# Keep this as the last instruction
RUN bootc container lint
