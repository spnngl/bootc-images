# syntax=docker.io/docker/dockerfile:1

# Base image major release, also the tag of this image. CI sets it with
# --build-arg (.github/workflows/build.yml); keep this default in sync.
# Available tags: https://quay.io/repository/almalinuxorg/almalinux-bootc?tab=tags
ARG BASE_VERSION=10.2

# Derived AlmaLinux bootc image, in stages:
#   - base: the host system (firewalld with geo-blocking, sshd, chrony,
#     systemd-networkd...). Not an image on its own.
#   - kubeenv (FROM base): adds k3s, no Docker. Tag suffix -k3s.
#   - dockerenv (FROM base, the default target): adds Docker.
#
# Build commands, same tags as CI (.github/workflows/build.yml):
#   podman build --format=docker -f images/almalinux/Containerfile -t ghcr.io/spnngl/bootc-images/almalinux:10.2 images/
#   podman build --format=docker --target kubeenv -f images/almalinux/Containerfile -t ghcr.io/spnngl/bootc-images/almalinux:10.2-k3s images/
#
# scripts/build.sh does the first one (default target only) and also builds a
# qcow2 disk image; scripts/run.sh boots it in QEMU.
#
# NB: This image ships no users, passwords or SSH keys.
# Docs: https://bootc.dev/bootc/building/guidance.html

# Build-only stage: downloads the geo-blocking data of the blocked countries
# and 10 public threat feeds, then turns them into firewalld ipsets under
# /out with geoblock.nu. Nothing from this stage reaches the final image
# except /out.
#
# ADD, not RUN curl: buildah puts the digest of the downloaded content in
# the build cache key, so changed data reruns the steps below and
# unchanged data reuses the cache. Refreshing the data means rebuilding
# the image; there is no timer or cron job.
#
# The output is plain data, the same for every platform.
FROM --platform=${BUILDPLATFORM} ghcr.io/nushell/nushell:0.116.0-alpine AS geoblock

# The nushell image runs as user "nushell": switch back to root so the
# RUN below can write /out, and its output is owned by root like the rest
# of the final image. This stage is never run as a container.
# hadolint ignore=DL3002
USER root
# RUN takes nushell code directly. No config file: the build must not
# depend on the image's default config.
SHELL ["/usr/bin/nu", "--no-history", "--no-config-file", "-c"]

# Blocked countries, ipdeny aggregated IPv4 zones (ISO 3166-1 alpha-2
# codes): Afghanistan, Azerbaijan, Bangladesh, Brazil, China, Iran, Iraq,
# North Korea, Pakistan, Russia, Turkey. Several sources: ADD names each
# file after its URL. IPv4 only, like everything here: IPv6 is disabled
# (fedora/sysroot/etc/sysctl.d/990-disable-ipv6.conf).
ADD --chmod=0644 \
    https://www.ipdeny.com/ipblocks/data/aggregated/af-aggregated.zone https://www.ipdeny.com/ipblocks/data/aggregated/az-aggregated.zone https://www.ipdeny.com/ipblocks/data/aggregated/bd-aggregated.zone https://www.ipdeny.com/ipblocks/data/aggregated/br-aggregated.zone https://www.ipdeny.com/ipblocks/data/aggregated/cn-aggregated.zone https://www.ipdeny.com/ipblocks/data/aggregated/ir-aggregated.zone https://www.ipdeny.com/ipblocks/data/aggregated/iq-aggregated.zone https://www.ipdeny.com/ipblocks/data/aggregated/kp-aggregated.zone https://www.ipdeny.com/ipblocks/data/aggregated/pk-aggregated.zone https://www.ipdeny.com/ipblocks/data/aggregated/ru-aggregated.zone https://www.ipdeny.com/ipblocks/data/aggregated/tr-aggregated.zone /out/usr/share/geoblock/countries/
# AbuseIPDB 100 % confidence score, last 24 h (~67 K)
ADD --chmod=0644 \
    https://raw.githubusercontent.com/borestad/blocklist-abuseipdb/refs/heads/main/abuseipdb-s100-1d.ipv4 /out/usr/share/geoblock/blocklists/abuseipdb.txt
# FireHOL level 1 -- aggregated worst-of-the-worst netsets (~4.5 K)
ADD --chmod=0644 \
    https://iplists.firehol.org/files/firehol_level1.netset /out/usr/share/geoblock/blocklists/firehol-level1.txt
# IPsum threat level >= 5 -- consensus across 5+ blacklists (~3.5 K)
ADD --chmod=0644 \
    https://raw.githubusercontent.com/stamparm/ipsum/refs/heads/master/levels/5.txt /out/usr/share/geoblock/blocklists/ipsum-level5.txt
# Binary Defense ban list -- active attackers (~8 K)
ADD --chmod=0644 \
    https://binarydefense.com/banlist.txt /out/usr/share/geoblock/blocklists/binarydefense.txt
# Spamhaus DROP -- hijacked/leased netblocks (~1.6 K CIDRs)
ADD --chmod=0644 \
    https://www.spamhaus.org/drop/drop.txt /out/usr/share/geoblock/blocklists/spamhaus-drop.txt
# Romain Marcoux -- aggregated malicious IPs (40 K)
ADD --chmod=0644 \
    https://raw.githubusercontent.com/romainmarcoux/malicious-ip/refs/heads/main/full-40k.txt /out/usr/share/geoblock/blocklists/malicious-ip.txt
# Data-Shield -- critical threat IPs (~101 K)
ADD --chmod=0644 \
    https://raw.githubusercontent.com/duggytuxy/Data-Shield_IPv4_Blocklist/refs/heads/main/prod_critical_data-shield_ipv4_blocklist.txt /out/usr/share/geoblock/blocklists/data-shield.txt
# CINS Army -- top attackers by CINS score (~15 K)
ADD --chmod=0644 \
    https://cinsscore.com/list/ci-badguys.txt /out/usr/share/geoblock/blocklists/cinsscore.txt
# blocklist.de -- fail2ban aggregated list (~22 K)
ADD --chmod=0644 \
    https://lists.blocklist.de/lists/all.txt /out/usr/share/geoblock/blocklists/blocklist-de.txt
# Emerging Threats -- known compromised IPs
ADD --chmod=0644 \
    https://rules.emergingthreats.net/blockrules/compromised-ips.txt /out/usr/share/geoblock/blocklists/emerging-threats.txt
COPY almalinux/geoblock.nu almalinux/test_geoblock.nu /geoblock/
# The static bogon ipset: geoblock.nu fails on a country network that
# overlaps it.
COPY almalinux/sysroot/usr/lib/firewalld/ipsets/geoblock-bogons.xml /geoblock/bogons/

# firewall-offline-cmd --check-config does not validate ipset entries;
# geoblock.nu is the only thing that does, so its tests run here, before it
# runs on the real data. `use x.nu` makes x.nu's main the command `x`.
WORKDIR /geoblock
# ShellCheck, which hadolint runs on RUN, does not know nushell.
# hadolint ignore=SC1008
RUN <<EORUN
use test_geoblock.nu
use geoblock.nu
test_geoblock
geoblock /out/usr/share/geoblock bogons /out/usr/lib/firewalld/ipsets
EORUN


# The host system, shared by dockerenv and kubeenv.
FROM quay.io/almalinuxorg/almalinux-bootc:${BASE_VERSION} AS base

ARG SOURCE_DATE_EPOCH=0
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH}

ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8
ENV TZ=UTC

SHELL ["/bin/bash", "-xeuo", "pipefail", "-c"]

# Copy static configuration files, keeping the modes of the build context
# (0755 directories, 0644 files). No --chmod: buildah applies it to
# directories too, and 0644 on /usr, /etc... breaks every non-root service
# (systemd-resolved included).
COPY --link ./fedora/sysroot/ /

# Geo-blocking and blocklist ipsets built in the "geoblock" stage above.
# This must come before the policies below: a policy that references a
# missing ipset makes every firewall-offline-cmd call fail.
COPY --link --from=geoblock /out/ /
# Geo-blocking policies and the static bogon ipsets they use.
COPY --link ./almalinux/sysroot/ /

RUN <<EORUN
# Install base stuff + repos
dnf -y install ca-certificates dnf-plugins-core epel-release \
    glibc-langpack-en glibc-langpack-fr

# Install packages (needs epel)
dnf -y install \
    sysstat iproute iputils procps-ng util-linux coreutils \
    e2fsprogs mdadm lvm2 cryptsetup tree htop btrfs-progs firewalld \
    netcat vim git nftables podman buildah \
    systemd-networkd systemd-resolved containers-common

# TZ
ln -sf ../usr/share/zoneinfo/Europe/Paris /etc/localtime

# chrony.conf has no include directory: replace its default pool with a
# sources directory, filled by etc/chrony/sources.d/. Fail if the pool line
# was not found.
sed -i 's|^pool .*|sourcedir /etc/chrony/sources.d|' /etc/chrony.conf
grep -qx 'sourcedir /etc/chrony/sources.d' /etc/chrony.conf

# Firewall
#
# Used ports
# - 80+443: HTTP(S)
# - 42022: sshd (etc/ssh/sshd_config.d/10-myssh.conf)
#
# TODO selinux one day
firewall-offline-cmd --add-port=80/tcp --add-port=443/tcp --add-port=42022/tcp
firewall-offline-cmd --zone=public --remove-service-from-zone=cockpit --remove-service-from-zone=ssh
firewall-offline-cmd --check-config

# Systemd services
systemctl disable NetworkManager
systemctl mask NetworkManager
systemctl enable sshd.service firewalld.service \
    systemd-resolved.service systemd-networkd.service \
    mdmonitor.service

# Cleanup
dnf -y autoremove
dnf clean all
rm -rf /var/log/* /var/cache/* /var/lib/dnf /tmp/* /run/dnf*
EORUN


# Kubernetes environment: k3s, without Docker. Its container runtime is the
# containerd embedded in k3s (/run/k3s/containerd, `k3s ctr`/`ctr`).
# The CNI is Cilium, installed on the cluster, hence no flannel, kube-proxy
# or network policy controller.
# Requirements: https://docs.k3s.io/installation/requirements?os=rhel
# (kernel-modules-extra, needed on RHEL 10, is already in the base image).
FROM base AS kubeenv

# k3s release, also the tag of its install script: bumping it reruns the
# install. https://github.com/k3s-io/k3s/releases
ARG K3S_VERSION=v1.36.5+k3s1

# SHELL (with -o pipefail) is inherited from base: hadolint doesn't follow
# it across stages.
# hadolint ignore=DL4006
RUN <<EORUN
# Firewall
#
# Used ports
# - 6443: k3s supervisor and Kubernetes API server
#
# k3s requires firewalld to trust its pod and service CIDRs. Cilium sets
# them: trust all of 10.0.0.0/8, which holds them. Without it, the public
# zone's geoblock policy drops them as private (geoblock-bogons). Traffic
# between nodes goes through Cilium's WireGuard tunnel, from node IPs.
firewall-offline-cmd --add-port=6443/tcp
firewall-offline-cmd --zone=trusted --add-source=10.0.0.0/8
firewall-offline-cmd --check-config

# Install k3s with the install script of the same release, which checks the
# binary's sha256. No SELinux RPM: SELinux is permissive
# (fedora/sysroot/etc/selinux/config).
# INSTALL_K3S_SKIP_ENABLE: the script's enable also runs
# `systemctl daemon-reload`, which fails without a running systemd. The
# service is enabled below instead.
curl -sfL "https://raw.githubusercontent.com/k3s-io/k3s/${K3S_VERSION}/install.sh" \
    | INSTALL_K3S_VERSION="${K3S_VERSION}" \
        INSTALL_K3S_SKIP_ENABLE=true \
        INSTALL_K3S_SKIP_SELINUX_RPM=true \
        INSTALL_K3S_SELINUX_WARN=true \
        INSTALL_K3S_SKIP_START=true \
        INSTALL_K3S_EXEC="--flannel-backend=none --disable-kube-proxy --disable-network-policy --disable=traefik" \
        sh -

# Systemd services
systemctl enable k3s.service

# dnf install -y cloud-init

# Cleanup
dnf -y autoremove
dnf clean all
rm -rf /var/log/* /var/cache/* /var/lib/dnf /tmp/* /run/dnf*
EORUN

# Keep this as the last instruction, on its own.
# hadolint ignore=DL3059
RUN bootc container lint


# Docker environment. Last stage, so the default target: it is the plain
# almalinux:<version> image, kubeenv being almalinux:<version>-k3s.
FROM base AS dockerenv

RUN <<EORUN
# Docker repos, have to use centos one to have everything
dnf-3 config-manager --add-repo https://download.docker.com/linux/centos/docker-ce.repo

# Install docker stuff
dnf -y install docker-ce docker-ce-cli containerd.io docker-buildx-plugin \
    docker-compose-plugin docker-model-plugin

# Systemd services
systemctl enable docker.service containerd.service

# Cleanup
dnf -y autoremove
dnf clean all
rm -rf /var/log/* /var/cache/* /var/lib/dnf /tmp/* /run/dnf*
EORUN

# Keep this as the last instruction, on its own.
# hadolint ignore=DL3059
RUN bootc container lint
