# syntax=docker.io/docker/dockerfile:1

# Derived Fedora bootc image, in stages:
#   - base: the host system (firewalld, sshd, chrony, systemd-networkd...).
#     Not an image on its own.
#   - kubeenv (FROM base): adds k3s, no Docker. Tag suffix -k3s.
#   - dockerenv (FROM base, the default target): adds Docker.
#
# Build commands, same tags as CI (.github/workflows/build.yml):
#   podman build --format=docker -f images/fedora/Containerfile -t ghcr.io/spnngl/bootc-images/fedora:44 images/
#   podman build --format=docker --target kubeenv -f images/fedora/Containerfile -t ghcr.io/spnngl/bootc-images/fedora:44-k3s images/
#
# scripts/build.sh does the first one (default target only) and also builds a
# qcow2 disk image; scripts/run.sh boots it in QEMU.
#
# NB: This image ships no users, passwords or SSH keys.
# Docs: https://bootc.dev/bootc/building/guidance.html

# Base image major release, also the tag of this image. CI sets it with
# --build-arg (.github/workflows/build.yml); keep this default in sync.
# Available tags: https://quay.io/repository/fedora/fedora-bootc?tab=tags
ARG BASE_VERSION=44


# The host system, shared by dockerenv and kubeenv.
FROM quay.io/fedora/fedora-bootc:${BASE_VERSION} AS base

ARG SOURCE_DATE_EPOCH=0
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH}

ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8
ENV TZ=UTC

SHELL ["/bin/bash", "-xeuo", "pipefail", "-c"]

RUN <<EORUN
# Install base stuff + repos
dnf -y install ca-certificates dnf-plugins-core dnf5-plugins glibc-langpack-en glibc-langpack-fr \
    sysstat iproute iputils procps-ng util-linux coreutils e2fsprogs mdadm lvm2 cryptsetup

# Install packages
dnf -y install tree htop btrfs-progs firewalld netcat vim git nftables podman buildah systemd-networkd \
    containers-common

# TZ
ln -sf ../usr/share/zoneinfo/Europe/Paris /etc/localtime

# chrony.conf has no include directory: replace its default pool with a
# sources directory, filled by etc/chrony/sources.d/. Fail if the pool line
# was not found.
sed -i 's|^pool .*|sourcedir /etc/chrony/sources.d|' /etc/chrony.conf
grep -qx 'sourcedir /etc/chrony/sources.d' /etc/chrony.conf

# Firewall
#
# Used ports
# - 80+443: HTTP(S)
# - 42022: sshd (etc/ssh/sshd_config.d/10-myssh.conf)
#
# TODO selinux one day
firewall-offline-cmd --add-port=80/tcp --add-port=443/tcp --add-port=42022/tcp
firewall-offline-cmd --zone=public --remove-service-from-zone=cockpit --remove-service-from-zone=ssh

# Systemd services
systemctl disable NetworkManager
systemctl mask NetworkManager
systemctl enable sshd.service firewalld.service systemd-networkd.service \
    mdmonitor.service

# Cleanup
dnf -y autoremove
dnf clean all
rm -rf /var/log/* /var/cache/* /var/lib/dnf /tmp/* /run/dnf*
EORUN

# Copy static configuration files
COPY --link ./fedora/sysroot/ /


# Kubernetes environment: k3s, without Docker. Its container runtime is the
# containerd embedded in k3s (/run/k3s/containerd, `k3s ctr`/`ctr`).
# The CNI is Cilium, installed on the cluster, hence no flannel, kube-proxy
# or network policy controller.
# Requirements: https://docs.k3s.io/installation/requirements?os=rhel
FROM base AS kubeenv

# k3s release, also the tag of its install script: bumping it reruns the
# install. https://github.com/k3s-io/k3s/releases
ARG K3S_VERSION=v1.36.5+k3s1

RUN <<EORUN
# Firewall
#
# Used ports
# - 6443: k3s supervisor and Kubernetes API server
# - 51871/udp: Cilium WireGuard tunnel between nodes. In tunnel routing
#   mode VXLAN/Geneve runs inside it, so 8472/6081 stay closed. Cilium's
#   health checks use ICMP, which firewalld zones accept by default, so
#   4240/tcp stays closed too.
#   https://docs.cilium.io/en/stable/operations/system_requirements/#firewall-rules
# - 10250: kubelet, between all nodes (k3s requirements, for metrics-server).
#   Cilium's node-to-node encryption doesn't cover it: it leaves out
#   control-plane nodes, which k3s servers are, so server <-> agent node
#   traffic doesn't go through WireGuard.
#   https://docs.cilium.io/en/stable/security/network/encryption-wireguard/#node-to-node-encryption-beta
#
# 2379-2380 (embedded etcd) stay closed: the datastore is k3s' default,
# SQLite through kine, on a single server.
#
# k3s requires firewalld to trust its pod and service CIDRs, k3s' defaults:
# 10.42.0.0/16 and 10.43.0.0/16. Cilium's pod CIDR is set to the same
# (K3S.md). Without it, the public zone rejects pod traffic to the host.
firewall-offline-cmd --add-port=6443/tcp --add-port=10250/tcp --add-port=51871/udp
firewall-offline-cmd --zone=trusted --add-source=10.42.0.0/16 --add-source=10.43.0.0/16
firewall-offline-cmd --check-config

# Create k3s folders
mkdir -p /etc/rancher/k3s/config.yaml.d

# Install k3s with the install script of the same release, which checks the
# binary's sha256. Run twice, once per role, with the same binary:
# k3s.service runs `k3s server` (control-plane), k3s-agent.service
# `k3s agent`. The role is per host, so both stay disabled: see K3S.md.
# No SELinux RPM: SELinux is permissive (fedora/sysroot/etc/selinux/config).
#
# INSTALL_K3S_SKIP_ENABLE: the script's enable also runs
# `systemctl daemon-reload`, which fails without a running systemd.
# INSTALL_K3S_BIN_DIR: /usr/bin is read-only and updated with the image.
# The default, /usr/local/bin, is too only if the base image keeps
# /usr/local a directory, not a link to /var/usrlocal:
# https://bootc.dev/bootc/bootc-filesystem.7.html#usrlocal
# INSTALL_K3S_SYSTEMD_DIR: the units too, rather than /etc/systemd/system.
curl -sfLo /tmp/k3s-install.sh "https://raw.githubusercontent.com/k3s-io/k3s/${K3S_VERSION}/install.sh"
export INSTALL_K3S_SKIP_ENABLE=true INSTALL_K3S_SKIP_SELINUX_RPM=true \
    INSTALL_K3S_BIN_DIR=/usr/bin INSTALL_K3S_SYSTEMD_DIR=/usr/lib/systemd/system
INSTALL_K3S_VERSION="${K3S_VERSION}" \
    INSTALL_K3S_EXEC="server --flannel-backend=none --disable-kube-proxy --disable-network-policy --disable=traefik" \
    sh /tmp/k3s-install.sh
# The agent's server URL and token are machine-local, in
# /etc/rancher/k3s/config.yaml.
# See: https://docs.k3s.io/installation/configuration
INSTALL_K3S_SKIP_DOWNLOAD=true INSTALL_K3S_EXEC="agent" sh /tmp/k3s-install.sh
# The uninstall scripts can't work: they delete k3s' data and config, then
# fail to remove the binaries from the read-only /usr. Uninstalling is
# switching to another image (bootc switch).
rm /usr/bin/k3s-uninstall.sh /usr/bin/k3s-agent-uninstall.sh
# k3s-killall.sh only stops the units of /etc/systemd/system: point it to
# theirs. Fail if the script changed.
sed -i 's|/etc/systemd/system/k3s\*\.service|/usr/lib/systemd/system/k3s*.service|' /usr/bin/k3s-killall.sh
grep -q '^for service in /usr/lib/systemd/system/k3s\*\.service; do$' /usr/bin/k3s-killall.sh

# Cleanup
rm -rf /var/log/* /var/cache/* /tmp/*
EORUN

# Keep this as the last instruction, on its own.
# hadolint ignore=DL3059
RUN bootc container lint


# Docker environment. Last stage, so the default target: it is the plain
# fedora:<version> image, kubeenv being fedora:<version>-k3s.
FROM base AS dockerenv

RUN <<EORUN
# See https://docs.docker.com/engine/install/fedora/
dnf config-manager addrepo --from-repofile=https://download.docker.com/linux/fedora/docker-ce.repo

# Install docker stuff
dnf -y install docker-ce docker-ce-cli containerd.io docker-buildx-plugin \
    docker-compose-plugin docker-model-plugin

# Systemd services
systemctl enable docker.service containerd.service

# Cleanup
dnf -y autoremove
dnf clean all
rm -rf /var/log/* /var/cache/* /var/lib/dnf /tmp/* /run/dnf*
EORUN

# Keep this as the last instruction, on its own.
# hadolint ignore=DL3059
RUN bootc container lint
