# syntax=docker.io/docker/dockerfile:1

# Derived Fedora bootc image, in stages:
#   - base: the host system (firewalld, sshd, chrony, systemd-networkd...).
#     Not an image on its own.
#   - kubeenv (FROM base): adds k3s, no Docker. Tag suffix -k3s.
#   - dockerenv (FROM base, the default target): adds Docker.
#
# Build commands, same tags as CI (.github/workflows/build.yml):
#   podman build --format=docker -f images/fedora/Containerfile -t ghcr.io/spnngl/bootc-images/fedora:44 images/
#   podman build --format=docker --target kubeenv -f images/fedora/Containerfile -t ghcr.io/spnngl/bootc-images/fedora:44-k3s images/
#
# scripts/build.sh does the first one (default target only) and also builds a
# qcow2 disk image; scripts/run.sh boots it in QEMU.
#
# NB: This image ships no users, passwords or SSH keys.
# Docs: https://bootc.dev/bootc/building/guidance.html

# Base image major release, also the tag of this image. CI sets it with
# --build-arg (.github/workflows/build.yml); keep this default in sync.
# Available tags: https://quay.io/repository/fedora/fedora-bootc?tab=tags
ARG BASE_VERSION=44


# The host system, shared by dockerenv and kubeenv.
FROM quay.io/fedora/fedora-bootc:${BASE_VERSION} AS base

ARG SOURCE_DATE_EPOCH=0
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH}

ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8
ENV TZ=UTC

SHELL ["/bin/bash", "-xeuo", "pipefail", "-c"]

RUN <<EORUN
# Install base stuff + repos
dnf -y install ca-certificates dnf-plugins-core dnf5-plugins glibc-langpack-en glibc-langpack-fr \
    sysstat iproute iputils procps-ng util-linux coreutils e2fsprogs mdadm lvm2 cryptsetup

# Install packages
dnf -y install tree htop btrfs-progs firewalld netcat vim git \
    nftables podman buildah systemd-networkd containers-common

# TZ
ln -sf ../usr/share/zoneinfo/Europe/Paris /etc/localtime

# chrony.conf has no include directory: replace its default pool with a
# sources directory, filled by etc/chrony/sources.d/. Fail if the pool line
# was not found.
sed -i 's|^pool .*|sourcedir /etc/chrony/sources.d|' /etc/chrony.conf
grep -qx 'sourcedir /etc/chrony/sources.d' /etc/chrony.conf

# Firewall
#
# Used ports
# - 80+443: HTTP(S)
# - 42022: sshd (etc/ssh/sshd_config.d/10-myssh.conf)
#
# TODO selinux one day
firewall-offline-cmd --add-port=80/tcp --add-port=443/tcp --add-port=42022/tcp
firewall-offline-cmd --zone=public --remove-service-from-zone=cockpit --remove-service-from-zone=ssh

# Systemd services
systemctl disable NetworkManager
systemctl mask NetworkManager
systemctl enable sshd.service firewalld.service systemd-networkd.service \
    mdmonitor.service

# Cleanup
dnf -y autoremove
dnf clean all
rm -rf /var/log/* /var/cache/* /var/lib/dnf /tmp/* /run/dnf*
EORUN

# Copy static configuration files
COPY --link ./fedora/sysroot/ /


# Kubernetes environment: k3s, without Docker. Steps and reasons in
# images/k3s/install.sh, shared by every image; setup in K3S.md.
FROM base AS kubeenv

# Bind-mounted, not copied: the script stays out of the image.
RUN --mount=type=bind,source=k3s,target=/k3s bash /k3s/install.sh

# Keep this as the last instruction, on its own.
# hadolint ignore=DL3059
RUN bootc container lint


# Docker environment. Last stage, so the default target: it is the plain
# fedora:<version> image, kubeenv being fedora:<version>-k3s.
FROM base AS dockerenv

RUN <<EORUN
# See https://docs.docker.com/engine/install/fedora/
dnf config-manager addrepo --from-repofile=https://download.docker.com/linux/fedora/docker-ce.repo

# Install docker stuff
dnf -y install docker-ce docker-ce-cli containerd.io docker-buildx-plugin \
    docker-compose-plugin docker-model-plugin

# Systemd services
systemctl enable docker.service containerd.service

# Cleanup
dnf -y autoremove
dnf clean all
rm -rf /var/log/* /var/cache/* /var/lib/dnf /tmp/* /run/dnf*
EORUN

# Keep this as the last instruction, on its own.
# hadolint ignore=DL3059
RUN bootc container lint
